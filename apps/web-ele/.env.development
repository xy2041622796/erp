# 端口号
VITE_PORT=5777

VITE_BASE=/

# 请求路径
# VITE_BASE_URL=http://192.168.124.10
# VITE_BASE_URL=http://8.148.73.250:9908
VITE_BASE_URL=https://spark.lingmacn.com
# 接口地址
VITE_GLOB_API_URL=https://spark.lingmacn.com
# VITE_GLOB_API_URL=https://spark.lingmacn.com
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server
# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# vue-router 的模式
VITE_ROUTER_HISTORY=history

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 默认登录用户名
VITE_APP_DEFAULT_USERNAME=xiaoy
# 默认登录密码
VITE_APP_DEFAULT_PASSWORD=xy@666666

VITE_MALL_H5_DOMAIN='http://mall.yudao.iocoder.cn'

