user nginx;
worker_processes auto;
pid /var/run/nginx.pid;

# 错误日志
error_log /var/log/nginx/error.log notice;

events {
    worker_connections 4096;  # 每个 worker 进程的最大连接数
    multi_accept on;          # 启用多连接接受
    use epoll;                # 使用高效的 epoll 模型（Linux）
}

# HTTP 配置
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # 日志格式优化
    log_format upstreamlog escape=json '{"remoteaddr": "$remote_addr",'
                                       '"remotetime": "$time_iso8601",'
                                       '"requestaddr": "$request",'
                                       '"requesttimesp": "$request_time",'
                                       '"upstreamaddr": "$upstream_addr"}';
    access_log /var/log/nginx/access.log upstreamlog;

    # 文件传输优化
    sendfile on;                    # 启用 sendfile
    tcp_nopush on;                  # 减少网络分片，优化文件传输
    tcp_nodelay on;                 # 减少延迟
    sendfile_max_chunk 512k;        # 设置每次传输的最大数据块大小

    # 长连接超时时间
    keepalive_timeout 65;

    # Gzip 压缩优化
    gzip on;
    gzip_min_length 1024;           # 仅压缩大于 1KB 的文件
    gzip_comp_level 5;              # 设置为 5，平衡性能和压缩率
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_buffers 16 8k;             # Gzip 缓冲区
    gzip_http_version 1.1;          # 使用 HTTP/1.1
    gzip_proxied any;               # 允许代理请求启用 Gzip
    gzip_vary on;                   # 为不同的用户代理生成不同的压缩文件

    # 缓冲区优化
    client_body_buffer_size 128k;   # 设置客户端请求缓冲区大小
    client_max_body_size 100m;      # 设置最大请求体大小
    proxy_buffer_size 16k;          # 设置代理缓冲区大小
    proxy_buffers 4 32k;            # 设置代理缓冲区数量和大小
    proxy_busy_buffers_size 64k;    # 设置繁忙代理缓冲区大小

    # 代理超时设置
    proxy_connect_timeout 10s;      # 连接超时时间
    proxy_read_timeout 300s;         # 读取超时时间
    proxy_send_timeout 30s;         # 发送超时时间

    # 包含其他配置文件
    include /etc/nginx/conf.d/*.conf;

    server {
	    listen 80;
	    server_name lingmacn.com;
	    return 301 $scheme://www.lingmacn.com$request_uri;
    }

    server {
    		listen 80;
    		server_name www.lingmacn.com;

    		# 静态资源访问配置
        location /data/work {
            alias /etc/nginx/html;

            # 允许跨域访问
            add_header Access-Control-Allow-Origin "*";
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range";

            # 图片文件处理
            location ~* \.(jpg|jpeg|png|gif|ico|webp)$ {
                try_files $uri =404;
                expires 30d;
                access_log off;             # 关闭静态文件的访问日志，减少 I/O
                add_header Cache-Control "public, max-age=2592000";
            }
        }

        # 默认静态资源服务
        location / {
            root /etc/nginx/html/adminnet/wwwroot/qyapiCoreFront;
            index index.html Login.html;
            proxy_pass_request_headers on;
            proxy_http_version 1.1;
            proxy_set_header Host $host;

                # 静态文件缓存  
		    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|eot|ttc|map)$ {  
		        expires 30d;                # 设置缓存时间为 30 天  
		        add_header Cache-Control "public, max-age=2592000";  
		        access_log off;             # 关闭静态文件的访问日志，减少 I/O  
		        try_files $uri =404;        # 确保文件存在  
		    } 
        }

    }

    
	server {
	    listen 443 ssl;
	    server_name lingmacn.com;
	
	    ssl_certificate     /etc/nginx/ssl/scs1744614328426_www.lingmacn.com_server.crt;
	    ssl_certificate_key /etc/nginx/ssl/scs1744614328426_www.lingmacn.com_server.key;
	
	    return 301 https://www.lingmacn.com$request_uri;
	}

    # WebSocket 和 API 代理
    server {
         listen 443 ssl;
         #http2 on;
	    server_name www.lingmacn.com;
	
	    ssl_certificate     /etc/nginx/ssl/scs1744614328426_www.lingmacn.com_server.crt;
	    ssl_certificate_key /etc/nginx/ssl/scs1744614328426_www.lingmacn.com_server.key;
	
	    ssl_session_cache    shared:SSL:1m;
	    ssl_session_timeout  5m;
	    ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
	    ssl_ciphers          HIGH:!aNULL:!MD5;
	    ssl_prefer_server_ciphers  on; 

		location /api/websocket {
			proxy_pass http://172.16.67.246:48080/api/websocket;
			proxy_pass_request_headers on;
			proxy_http_version 1.1;
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection "upgrade";
			proxy_set_header Host $host;
		}

		location /api {
		   proxy_pass http://172.16.67.246:48080/api;
		   proxy_pass_request_headers on;
		   proxy_set_header Host $host;
		   proxy_set_header X-Real-IP $remote_addr;
		   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		   proxy_set_header Custom-Header $http_custom_header;
		   proxy_set_header Authorization $http_authorization;
		}

        # 静态资源访问配置
        location /data/work {
            alias /etc/nginx/html;

            # 允许跨域访问
            add_header Access-Control-Allow-Origin "*";
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range";

            # 图片文件处理
            location ~* \.(jpg|jpeg|png|gif|ico|webp)$ {
                try_files $uri =404;
                expires 30d;
                access_log off;             # 关闭静态文件的访问日志，减少 I/O
                add_header Cache-Control "public, max-age=2592000";
            }
        }

        # 默认静态资源服务
        location / {
            root /etc/nginx/html/adminnet/wwwroot/qyapiCoreFront;
            index index.html Login.html;
            proxy_pass_request_headers on;
            proxy_http_version 1.1;
            proxy_set_header Host $host;

                # 静态文件缓存  
		    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|eot|ttc|map)$ {  
		        expires 30d;                # 设置缓存时间为 30 天  
		        add_header Cache-Control "public, max-age=2592000";  
		        access_log off;             # 关闭静态文件的访问日志，减少 I/O  
		        try_files $uri =404;        # 确保文件存在  
		    } 
        }
    }
}